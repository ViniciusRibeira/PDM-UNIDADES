<!DOCTYPE html>
<html>
<head>
    <title>Teste Webhook PDM</title>
    <style>
        body { font-family: Arial; padding: 20px; background: #0f0f23; color: #e0e0e0; }
        .box { background: #1a1a3a; padding: 20px; margin: 20px 0; border-radius: 8px; border-left: 4px solid #d4af37; }
        button { background: #d4af37; color: #0f0f23; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: 700; }
        pre { background: #0d0d20; padding: 15px; border-radius: 4px; overflow-x: auto; }
        .ok { color: #4ade80; }
        .erro { color: #dc2626; }
    </style>
</head>
<body>
    <h1>🧪 Teste do Webhook PDM</h1>

    <div class="box">
        <h2>1. Testar Webhook</h2>
        <button onclick="testarWebhook()">Testar Agora</button>
        <pre id="resultado"></pre>
    </div>

    <div class="box">
        <h2>2. Dados Carregados</h2>
        <pre id="dados"></pre>
    </div>

    <script>
        const WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbwruLutpPmk8JzfBM-adet2V7wPyHwGQZtLMTEnkEM7cdekkzQfhlclY9eA2LEuXz66BQ/exec";

        async function testarWebhook() {
            const resultado = document.getElementById('resultado');
            resultado.innerHTML = '⏳ Carregando...';

            try {
                const resp = await fetch(WEBHOOK_URL);
                const text = await resp.text();
                const data = JSON.parse(text);

                if (Array.isArray(data)) {
                    resultado.innerHTML = `<span class="ok">✅ Webhook OK!</span>\n\nTotal de ações: ${data.length}\n\n${JSON.stringify(data, null, 2)}`;
                    document.getElementById('dados').innerHTML = `<span class="ok">✅ ${data.length} ações carregadas!</span>`;
                } else {
                    resultado.innerHTML = `<span class="erro">❌ Resposta inválida</span>\n\n${JSON.stringify(data, null, 2)}`;
                }
            } catch (e) {
                resultado.innerHTML = `<span class="erro">❌ ERRO: ${e.message}</span>`;
            }
        }

        // Testa automaticamente ao abrir
        testarWebhook();
    </script>
</body>
</html>
